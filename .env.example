# ═══════════════════════════════════════════════════════════════
#  배포(Vercel) — 여러 사용자용. 사용자별 Notion·설정은 DB 에 저장되고, 아래는 운영자 설정만.
# ═══════════════════════════════════════════════════════════════

# ───────── 데이터베이스 (Neon Postgres) ─────────
# Vercel → Storage → Neon 연결 시 자동으로 들어가요. 표는 첫 요청 때 자동 생성(마이그레이션)돼요.
DATABASE_URL=

# ───────── 보안 ─────────
# 32자 이상 랜덤 문자열 2개 (openssl rand -base64 48). ENCRYPTION_KEY 는 바꾸면 저장된 Notion 토큰을 못 읽어요!
SESSION_SECRET=
ENCRYPTION_KEY=

# ───────── GitHub 로그인 (누구나 가입) ─────────
# GitHub OAuth App — Callback URL: https://<your-app>.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 관리자(AI 무제한, 1인용 시절 캡처 열람) GitHub 숫자 ID, 쉼표 구분
ADMIN_GITHUB_IDS=

# ───────── Notion 공개 통합 (사용자가 "Notion 연결" 버튼으로 연결) ─────────
# https://www.notion.so/profile/integrations → Public integration
#   Redirect URI: https://<your-app>.vercel.app/api/notion/callback
#   개인정보처리방침 URL: https://<your-app>.vercel.app/privacy · 이용약관 URL: …/terms
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# (선택) Notion webhook 검증 토큰 — 대시보드 즉시 갱신용. Webhook URL: …/api/notion-webhook
NOTION_WEBHOOK_TOKEN=

# ───────── AI (운영자 키로 비용 부담) ─────────
ANTHROPIC_API_KEY=
# 사용자당 월 AI 호출 수 (주간 정리·블로그 초안·공고 맞춤 각 1회). 기본 30
AI_MONTHLY_LIMIT=30
# 기본값 claude-opus-5-5
# ANTHROPIC_MODEL=

# ───────── 파일 (Vercel Blob store 2개) ─────────
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
PUBLIC_IMAGE_HOSTS=public.blob.vercel-storage.com

# ───────── 자동 작업 (Vercel Cron, apps/web/vercel.json) ─────────
# 설정하면 Vercel 이 cron 호출에 Authorization: Bearer <CRON_SECRET> 을 붙여요
CRON_SECRET=

# ───────── (선택) 개인정보처리방침·약관에 표시할 문의처 ─────────
CONTACT_EMAIL=

# ═══════════════════════════════════════════════════════════════
#  로컬 개발 · CLI (jobs/) 전용 — 배포 환경에는 넣지 마세요
# ═══════════════════════════════════════════════════════════════
# DATABASE_URL 없이 DEV_BYPASS_AUTH=1 로 띄우면 아래 .env 값으로 1인용처럼 동작해요 (pnpm dev 에서만)
# DEV_BYPASS_AUTH=1
# 가짜 Notion 서버(pnpm mock:notion)를 쓸 때만. 실제 Notion 을 쓸 땐 넣지 마세요
# NOTION_BASE_URL=http://localhost:4010

# 내부 통합 토큰 + pnpm setup:notion 결과 (CLI 배치 · env 모드 대시보드용)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DS_WORK_LOG=
NOTION_DS_PROJECTS=
NOTION_DS_RECORDS=
NOTION_DS_METRICS=
NOTION_DS_ACHIEVEMENTS=
NOTION_DS_POSTS=
NOTION_DS_ATTACHMENTS=
NOTION_RESUME_PAGE_ID=

# env 모드 / CLI 의 사용자 설정 (배포 환경에서는 각자 설정 화면에서)
DENYLIST=회사명=A사,고객사명=B사,내부시스템명=사내 시스템
RESUME_NAME=
RESUME_HEADLINE=
VELOG_USERNAME=
POST_INTERVAL_DAYS=14
POST_LEAD_DAYS=3
NOTIFY_WEBHOOK_URL=

# CLI 배치 후 대시보드 캐시 갱신 (선택): 배포 주소 + 내 사용자 ID(설정 화면 URL 이 아니라 DB users.id)
WEB_URL=https://your-app.vercel.app
REVALIDATE_SECRET=
CAREERSYNC_USER_ID=

# (비활성화) velog 자동 발행 — 다시 켤 때만
# AUTO_PUBLISH=1
# VELOG_ACCESS_TOKEN=
# VELOG_REFRESH_TOKEN=
