# ───────── Notion ─────────
# 개인 워크스페이스의 내부 통합(Internal integration) 토큰
NOTION_TOKEN=
# setup:notion 이 DB 를 만들 상위 페이지 — 링크를 그대로 붙여넣어도 돼요 (통합을 이 페이지에 "연결" 해 두세요)
NOTION_PARENT_PAGE_ID=
# ↓ pnpm setup:notion 실행 결과를 붙여넣기
NOTION_DS_WORK_LOG=
NOTION_DS_PROJECTS=
NOTION_DS_RECORDS=
NOTION_DS_METRICS=
NOTION_DS_ACHIEVEMENTS=
NOTION_DS_POSTS=
NOTION_DS_ATTACHMENTS=
NOTION_RESUME_PAGE_ID=
# (선택) Notion webhook 검증 토큰 — 대시보드 즉시 갱신용
NOTION_WEBHOOK_TOKEN=

# ───────── LLM (jobs + 대시보드 "공고 맞춤 이력서") ─────────
# 대시보드에서 AI 맞춤 이력서를 쓰려면 Vercel 환경변수에도 ANTHROPIC_API_KEY 를 넣으세요
# 방법 1) API 키 — 만료되면 Console 에서 새 키로 교체 (코드로 자동 갱신 불가)
# 방법 2) 비워 두고 `ant auth login` — SDK 가 로그인 프로필을 자동으로 사용·갱신 (로컬 권장)
# 연결 확인: pnpm check:claude
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5
# ANTHROPIC_MODEL=

# ───────── 보안 마스킹 ─────────
# 형식: 원래단어=치환어 (쉼표 또는 줄바꿈 구분). 레포에 커밋하지 말 것!
DENYLIST=회사명=A사,고객사명=B사,내부시스템명=사내 시스템

# ───────── Vercel 대시보드 ─────────
# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
#   Callback URL: https://<your-app>.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 본인 GitHub 숫자 ID (https://api.github.com/users/<username> 의 id)
ALLOWED_GITHUB_ID=
# 32자 이상 랜덤 문자열 (openssl rand -base64 48)
SESSION_SECRET=
# Vercel Blob store 2개 (private / public) 의 read-write 토큰
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
# 이력서 상단
RESUME_NAME=
RESUME_HEADLINE=

# ───────── jobs → 대시보드 캐시 갱신 ─────────
WEB_URL=https://your-app.vercel.app
REVALIDATE_SECRET=

# ───────── velog ─────────
# RSS 동기화용 (발행된 velog 글 URL 자동 기록)
VELOG_USERNAME=
PUBLIC_IMAGE_HOSTS=public.blob.vercel-storage.com
# 초안 작성 주기 (일) / 목표일 며칠 전에 초안을 만들지
POST_INTERVAL_DAYS=14
POST_LEAD_DAYS=3

# ───────── (비활성화) velog 자동 발행 — 다시 켤 때만 ─────────
# AUTO_PUBLISH=1
# VELOG_ACCESS_TOKEN=
# VELOG_REFRESH_TOKEN=
# POST_DEFAULT_MODE=임시저장
# POST_PUBLISH_HOUR_KST=9

# ───────── 알림 (선택) ─────────
# Slack Incoming Webhook 또는 Discord Webhook URL
NOTIFY_WEBHOOK_URL=

# ───────── 로컬 개발 ─────────
# 로그인 없이 대시보드 보기 (pnpm dev 에서만 동작, 배포에서는 무시)
# DEV_BYPASS_AUTH=1
# 가짜 Notion 서버(pnpm mock:notion)를 쓸 때만. 실제 Notion 을 쓸 땐 넣지 마세요
# NOTION_BASE_URL=http://localhost:4010
