# ───────── Notion ─────────
# 개인 워크스페이스의 내부 통합(Internal integration) 토큰
NOTION_TOKEN=
# setup:notion 이 DB 를 만들 상위 페이지 ID (통합을 이 페이지에 '연결' 해 두세요)
NOTION_PARENT_PAGE_ID=
# ↓ pnpm setup:notion 실행 결과를 붙여넣기
NOTION_DS_WORK_LOG=
NOTION_DS_PROJECTS=
NOTION_DS_RECORDS=
NOTION_DS_METRICS=
NOTION_DS_ACHIEVEMENTS=
NOTION_DS_POSTS=
NOTION_DS_ATTACHMENTS=
NOTION_RESUME_PAGE_ID=
# (선택) Notion webhook 검증 토큰 — 대시보드 즉시 갱신용
NOTION_WEBHOOK_TOKEN=

# ───────── LLM (jobs 전용) ─────────
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5
# ANTHROPIC_MODEL=

# ───────── 보안 마스킹 ─────────
# 형식: 원래단어=치환어 (쉼표 또는 줄바꿈 구분). 레포에 커밋하지 말 것!
DENYLIST=회사명=A사,고객사명=B사,내부시스템명=사내 시스템

# ───────── Vercel 대시보드 ─────────
# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
#   Callback URL: https://<your-app>.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 본인 GitHub 숫자 ID (https://api.github.com/users/<username> 의 id)
ALLOWED_GITHUB_ID=
# 32자 이상 랜덤 문자열 (openssl rand -base64 48)
SESSION_SECRET=
# Vercel Blob store 2개 (private / public) 의 read-write 토큰
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
# 이력서 상단
RESUME_NAME=
RESUME_HEADLINE=

# ───────── jobs → 대시보드 캐시 갱신 ─────────
WEB_URL=https://your-app.vercel.app
REVALIDATE_SECRET=

# ───────── velog ─────────
# RSS 동기화용 (발행된 velog 글 URL 자동 기록)
VELOG_USERNAME=
PUBLIC_IMAGE_HOSTS=public.blob.vercel-storage.com
# 초안 작성 주기 (일) / 목표일 며칠 전에 초안을 만들지
POST_INTERVAL_DAYS=14
POST_LEAD_DAYS=3

# ───────── (비활성화) velog 자동 발행 — 다시 켤 때만 ─────────
# AUTO_PUBLISH=1
# VELOG_ACCESS_TOKEN=
# VELOG_REFRESH_TOKEN=
# POST_DEFAULT_MODE=임시저장
# POST_PUBLISH_HOUR_KST=9

# ───────── 알림 (선택) ─────────
# Slack Incoming Webhook 또는 Discord Webhook URL
NOTIFY_WEBHOOK_URL=

# ───────── 로컬 개발 ─────────
# DEV_BYPASS_AUTH=1   # next dev 에서만 로그인 생략
# NOTION_BASE_URL=http://localhost:4010   # pnpm mock:notion 사용 시
